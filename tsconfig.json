{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2020"],
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*", "migrations/**/*", "target/types/**/*"]
}
